# SANGPA Environment Configuration
# Rename this file to .env and insert your API keys

# OpenAI API Key (used by serverless /api/chat - accepts OPENAI_API_KEY or VITE_OPENAI_API_KEY)
OPENAI_API_KEY=your_openai_api_key_here
VITE_OPENAI_API_KEY=your_openai_api_key_here
# Server-only ElevenLabs API Key (used by Vercel Serverless /api/tts - do NOT prefix with VITE_)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=5f1FjpWl2X8UqTlgo9Ov
